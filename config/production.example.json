{
  "listen_address": ":8080",
  "data_directory": "/var/lib/outcome-router",
  "admin_key_env": "OUTCOME_ROUTER_ADMIN_KEY",
  "catalog": {
    "frontier": {
      "id": "frontier",
      "provider": "openai",
      "upstream_model": "REPLACE_WITH_INCUMBENT_MODEL",
      "region": "us-east",
      "privacy": "zdr",
      "context_window": 128000,
      "supports_tools": true,
      "supports_structured": true,
      "supports_vision": true,
      "input_cost_per_million_tokens": 0,
      "output_cost_per_million_tokens": 0,
      "p95_latency_ms": 3000,
      "quality_prior": 0.9,
      "enabled": true,
      "version": "pinned-provider-version"
    }
  },
  "policies": [],
  "tenants": [
    {
      "id": "replace-me",
      "router_api_key_env": "TENANT_ROUTER_API_KEY",
      "default_policy_id": "replace-me",
      "providers": {
        "openai": {
          "id": "openai",
          "base_url": "https://api.openai.com/v1/chat/completions",
          "api_key_env": "OPENAI_API_KEY",
          "timeout_ms": 120000,
          "circuit_failures": 3,
          "circuit_open_ms": 30000
        }
      }
    }
  ]
}
